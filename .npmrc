# React Native / Metro tidak bisa menelusuri node_modules bergaya pnpm yang ketat
# (symlink + isolasi per-package). Expo mensyaratkan layout hoisted untuk
# monorepo pnpm. Tanpa ini, `expo export` gagal me-resolve dependensi transitif
# React Native.
#
# Efek samping: layout node_modules jadi mirip npm. apps/web tetap berjalan
# normal dengan ini (diverifikasi lewat build + test setelah diaktifkan).
node-linker=hoisted
