{
  "expo": {
    "name": "Soora",
    "slug": "soora",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": ["soora", "fun.soora.app"],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06060e",
    "android": {
      "package": "fun.soora.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#06060e"
      }
    },
    "ios": {
      "bundleIdentifier": "fun.soora.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
